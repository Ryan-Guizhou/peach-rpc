{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Logical RPC QPS",
      "targets": [
        {
          "expr": "sum(rate(peach_rpc_client_calls_seconds_count[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "RPC Error Rate",
      "targets": [
        {
          "expr": "sum(rate(peach_rpc_client_calls_seconds_count{status!=\"OK\"}[5m])) / clamp_min(sum(rate(peach_rpc_client_calls_seconds_count[5m])), 0.000001)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Active Connections",
      "targets": [
        {
          "expr": "sum(peach_rpc_connection_active)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Retry Rate",
      "targets": [
        {
          "expr": "sum(rate(peach_rpc_client_retries_total[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Client Call Latency Quantiles",
      "description": "Requires Prometheus histogram publication for peach.rpc.client.calls.",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(peach_rpc_client_calls_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(peach_rpc_client_calls_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.999, sum by (le) (rate(peach_rpc_client_calls_seconds_bucket[5m])))",
          "legendFormat": "p99.9",
          "refId": "C"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Resilience Events",
      "targets": [
        {
          "expr": "sum(rate(peach_rpc_client_circuit_rejected_total[5m]))",
          "legendFormat": "circuit rejected",
          "refId": "A"
        },
        {
          "expr": "sum(rate(peach_rpc_client_outlier_ejected_total[5m]))",
          "legendFormat": "outlier ejected",
          "refId": "B"
        },
        {
          "expr": "sum(rate(peach_rpc_server_admission_rejected_total[5m]))",
          "legendFormat": "provider admission rejected",
          "refId": "C"
        },
        {
          "expr": "sum by (reason) (rate(peach_rpc_client_retry_exhausted_total[5m]))",
          "legendFormat": "retry exhausted {{reason}}",
          "refId": "D"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Registry / TLS / Heartbeat Failures",
      "targets": [
        {
          "expr": "sum(rate(peach_rpc_registry_failures_total[5m]))",
          "legendFormat": "registry",
          "refId": "A"
        },
        {
          "expr": "sum(rate(peach_rpc_tls_handshake_failures_total[5m]))",
          "legendFormat": "tls",
          "refId": "B"
        },
        {
          "expr": "sum(rate(peach_rpc_connection_heartbeat_timeouts_total[5m]))",
          "legendFormat": "heartbeat timeout",
          "refId": "C"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "RPC Inflight",
      "targets": [
        {
          "expr": "sum(peach_rpc_client_inflight)",
          "legendFormat": "client logical calls",
          "refId": "A"
        },
        {
          "expr": "sum(peach_rpc_server_inflight)",
          "legendFormat": "provider invocations",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 22
      }
    },
    {
      "type": "timeseries",
      "title": "Timeout Rate",
      "targets": [
        {
          "expr": "sum(rate(peach_rpc_client_timeouts_total[5m]))",
          "legendFormat": "client timeout",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 22
      }
    },
    {
      "type": "timeseries",
      "title": "Circuit Breaker State",
      "targets": [
        {
          "expr": "sum by (state) (peach_rpc_client_circuit_state)",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 22
      }
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "peach-rpc",
    "rpc"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "Peach RPC Production Overview",
  "uid": "peach-rpc-production",
  "version": 1
}

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.peachsoft.otryx.comparison</groupId>
        <artifactId>rpc-comparison-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>rpc-comparison-peach</artifactId>
    <dependencies>
        <dependency>
            <groupId>com.peachsoft.otryx.comparison</groupId>
            <artifactId>rpc-comparison-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-core</artifactId>
            <version>${otryx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-codec-fory</artifactId>
            <version>${otryx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-transport-vertx</artifactId>
            <version>${otryx.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.peachsoft.otryx</groupId>
                            <artifactId>otryx-codegen</artifactId>
                            <version>${otryx.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase><goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>peach-comparison</finalName>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.peachsoft.otryx.compare.peach.OtryxComparisonMain</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

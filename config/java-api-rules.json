{
  "schema_version": 1,
  "rules": [
    {
      "id": "J001",
      "severity": "error",
      "message": "Production runtime must not call System.exit",
      "paths": [
        "peach-rpc-*/src/main/java/*.java"
      ],
      "scan": "code",
      "pattern": "\\bSystem\\s*\\.\\s*exit\\s*\\("
    },
    {
      "id": "J002",
      "severity": "error",
      "message": "Production runtime must not launch OS processes",
      "paths": [
        "peach-rpc-*/src/main/java/*.java"
      ],
      "scan": "code",
      "pattern": "\\b(?:ProcessBuilder\\s*\\(|Runtime\\s*\\.\\s*getRuntime\\s*\\(\\s*\\)\\s*\\.\\s*exec\\s*\\()"
    },
    {
      "id": "J003",
      "severity": "error",
      "message": "Use structured logging instead of printStackTrace",
      "paths": [
        "peach-rpc-*/src/main/java/*.java"
      ],
      "scan": "code",
      "pattern": "\\.\\s*printStackTrace\\s*\\("
    },
    {
      "id": "J004",
      "severity": "error",
      "message": "Do not print directly to System.out/err in production runtime",
      "paths": [
        "peach-rpc-*/src/main/java/*.java"
      ],
      "scan": "code",
      "pattern": "\\bSystem\\s*\\.\\s*(?:out|err)\\b"
    },
    {
      "id": "T001",
      "severity": "error",
      "message": "Transport hot path must not block with Thread.sleep",
      "paths": [
        "peach-rpc-transport-vertx/src/main/java/*.java"
      ],
      "scan": "code",
      "pattern": "\\bThread\\s*\\.\\s*sleep\\s*\\("
    },
    {
      "id": "T002",
      "severity": "error",
      "message": "Transport hot path must not block with TimeUnit.sleep",
      "paths": [
        "peach-rpc-transport-vertx/src/main/java/*.java"
      ],
      "scan": "code",
      "pattern": "\\bTimeUnit\\s*\\.\\s*\\w+\\s*\\.\\s*sleep\\s*\\("
    },
    {
      "id": "L001",
      "severity": "error",
      "message": "Use parameterized SLF4J logs, not string concatenation",
      "paths": [
        "peach-rpc-*/src/main/java/*.java"
      ],
      "scan": "with-strings",
      "pattern": "\\b(?:LOGGER|log|logger)\\s*\\.\\s*(?:trace|debug|info|warn|error)\\s*\\(\\s*\"(?:\\\\.|[^\"\\\\])*\"\\s*\\+\\s*(?:[A-Za-z_$]|\\()"
    },
    {
      "id": "L002",
      "severity": "error",
      "message": "Runtime log message must be English",
      "paths": [
        "peach-rpc-*/src/main/java/*.java"
      ],
      "scan": "with-strings",
      "pattern": "\\b(?:LOGGER|log|logger)\\s*\\.\\s*(?:trace|debug|info|warn|error)\\s*\\(\\s*\"(?:\\\\.|[^\"\\\\])*[\\u4e00-\\u9fff](?:\\\\.|[^\"\\\\])*\""
    },
    {
      "id": "R001",
      "severity": "warning",
      "message": "Check catch(Throwable) for fatal error and cancellation isolation",
      "paths": [
        "peach-rpc-*/src/main/java/*.java"
      ],
      "scan": "code",
      "pattern": "\\bcatch\\s*\\(\\s*Throwable\\b"
    },
    {
      "id": "B001",
      "severity": "error",
      "message": "Core must not import implementation adapters or Spring framework",
      "paths": [
        "peach-rpc-core/src/main/java/*.java"
      ],
      "scan": "code",
      "pattern": "^\\s*import\\s+(?:static\\s+)?(?:io\\.vertx|com\\.alibaba\\.nacos|io\\.etcd|org\\.apache\\.fory|org\\.springframework)\\."
    },
    {
      "id": "R002",
      "severity": "error",
      "message": "Production runtime must not construct an unbounded LinkedBlockingQueue",
      "paths": [
        "peach-rpc-*/src/main/java/*.java"
      ],
      "scan": "code",
      "pattern": "\\bnew\\s+LinkedBlockingQueue(?:\\s*<[^>]*>)?\\s*\\(\\s*\\)"
    },
    {
      "id": "R003",
      "severity": "error",
      "message": "Production runtime must not create unbounded cached thread pools",
      "paths": [
        "peach-rpc-*/src/main/java/*.java"
      ],
      "scan": "code",
      "pattern": "\\bExecutors\\s*\\.\\s*newCachedThreadPool\\s*\\("
    },
    {
      "id": "L003",
      "severity": "error",
      "message": "Use parameterized SLF4J instead of String.format within log call",
      "paths": [
        "peach-rpc-*/src/main/java/*.java"
      ],
      "scan": "code",
      "pattern": "\\b(?:LOGGER|log|logger)\\s*\\.\\s*(?:trace|debug|info|warn|error)\\s*\\(\\s*String\\s*\\.\\s*format\\s*\\("
    },
    {
      "id": "L004",
      "severity": "warning",
      "message": "Inspect runtime log statement for sensitive fields and token exposure",
      "paths": [
        "peach-rpc-*/src/main/java/*.java"
      ],
      "scan": "with-strings",
      "pattern": "\\b(?:LOGGER|log|logger)\\s*\\.\\s*(?:trace|debug|info|warn|error)\\s*\\([\\s\\S]{0,180}\\b(?:password|secret|token|credential)\\b"
    },
    {
      "id": "N001",
      "severity": "warning",
      "message": "Interface I-prefix naming requires compatibility review before rename",
      "paths": [
        "peach-rpc-*/src/main/java/*.java"
      ],
      "scan": "code",
      "pattern": "\\binterface\\s+I[A-Z][A-Za-z0-9_]*\\b"
    }
  ]
}

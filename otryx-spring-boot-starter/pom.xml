<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.peach.rpc</groupId>
        <artifactId>peach-rpc-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>peach-rpc-spring-boot-starter</artifactId>
    <name>peach-rpc-spring-boot-starter</name>
    <description>Peach RPC Spring Boot starter.</description>

    <dependencies>
        <dependency>
            <groupId>io.peach.rpc</groupId>
            <artifactId>peach-rpc-spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>io.peach.rpc</groupId>
            <artifactId>peach-rpc-registry-etcd</artifactId>
        </dependency>
        <dependency>
            <groupId>io.peach.rpc</groupId>
            <artifactId>peach-rpc-registry-nacos</artifactId>
        </dependency>
        <dependency>
            <groupId>io.peach.rpc</groupId>
            <artifactId>peach-rpc-proxy-cglib</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <configuration>
                            <skipSource>true</skipSource>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-placeholder-sources</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>sources</classifier>
                                    <classesDirectory>
                                        ${project.basedir}/src/central-placeholder
                                    </classesDirectory>
                                </configuration>
                            </execution>
                            <execution>
                                <id>attach-placeholder-javadoc</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <classesDirectory>
                                        ${project.basedir}/src/central-placeholder
                                    </classesDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
